          "PromiseDate",
          "Carrier",
          "Instructions",
          "PO",
          "Terms",
          "SalesRep",
          "BillToID",
          "ShipToID",
          "OrderStatus",
          "Creditcard"
        ],
        "properties": {
          "Ordernum": {
            "type": "integer",
            "description": "Order number (read-only, assigned by the server)",
            "readOnly": true
          },
          "Customer": {
            "$ref": "#/components/schemas/CustomerV2"
          },

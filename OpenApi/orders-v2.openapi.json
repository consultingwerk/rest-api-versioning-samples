            "maxLength": 20,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderV2Patch": {
        "type": "object",
        "description": "PATCH body (v2): only the fields to change, null sets the value to unknown",
        "properties": {
          "Ordernum": {
            "type": "integer",
            "description": "Order number (read-only, assigned by the server)",
            "readOnly": true
          },
          "Customer": {
            "$ref": "#/components/schemas/CustomerV2"
          },
          "OrderDate": {
            "type": "string",
            "description": "Order date",
            "format": "date",
            "nullable": true
          },
          "ShipDate": {
            "type": "string",

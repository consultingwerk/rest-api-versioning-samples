{
  "openapi": "3.0.3",
  "info": {
    "title": "Sports2000 Orders API - v2",
    "version": "2.0.0",
    "description": "Current version. Breaking changes compared to v1: the customer (CustNum and address) is a nested object \"Customer\", WarehouseNum is removed (sending it returns 400). Version v0 has been switched off: every request to /v0 returns 410 Gone with a Link to the successor version."
  },
  "servers": [
    {
      "url": "/web/v2",
      "description": "Fixed URI per version"
    },
    {
      "url": "/web/api/v2",
      "description": "One handler, version as path parameter"
    }
  ],
  "paths": {
    "/Orders": {
      "get": {
        "tags": [
          "Orders v2"
        ],
        "summary": "List orders (paged)",
        "responses": {
          "200": {
            "description": "A page of orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderV2Page"
                }
              }
            }
          },
          "400": {
            "description": "Unknown field, missing required field or invalid value",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "top",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Create an order",
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderV2"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "URI of the new order",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Unknown field, missing required field or invalid value",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderV2Post"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Not supported - DELETE is not part of any version",
        "responses": {
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Allow": {
                "description": "The methods the resource supports (RFC 9110)",
                "schema": {
                  "type": "string",
                  "example": "GET, PUT, PATCH"
                }
              }
            }
          }
        }
      }
    },
    "/Orders/{Ordernum}": {
      "parameters": [
        {
          "name": "Ordernum",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          },
          "example": 1001
        }
      ],
      "get": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Read an order",
        "responses": {
          "200": {
            "description": "The order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderV2"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Replace an order (complete writable representation)",
        "responses": {
          "200": {
            "description": "The updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderV2"
                }
              }
            }
          },
          "400": {
            "description": "Unknown field, missing required field or invalid value",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderV2Put"
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Change single fields of an order (null sets the value to unknown)",
        "responses": {
          "200": {
            "description": "The updated order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderV2"
                }
              }
            }
          },
          "400": {
            "description": "Unknown field, missing required field or invalid value",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Order not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderV2Patch"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Orders v2"
        ],
        "summary": "Not supported - DELETE is not part of any version",
        "responses": {
          "405": {
            "description": "Method not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "headers": {
              "Allow": {
                "description": "The methods the resource supports (RFC 9110)",
                "schema": {
                  "type": "string",
                  "example": "GET, PUT, PATCH"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CustomerV2": {
        "type": "object",
        "description": "The customer of the order. Only CustNum is writable.",
        "properties": {
          "CustNum": {
            "type": "integer",
            "description": "Customer number"
          },
          "Name": {
            "type": "string",
            "description": "Customer name (read-only)",
            "readOnly": true
          },
          "Address": {
            "type": "string",
            "description": "Customer address (read-only)",
            "readOnly": true
          },
          "Address2": {
            "type": "string",
            "description": "Customer address line 2 (read-only)",
            "readOnly": true
          },
          "PostalCode": {
            "type": "string",
            "description": "Customer postal code (read-only)",
            "readOnly": true
          },
          "City": {
            "type": "string",
            "description": "Customer city (read-only)",
            "readOnly": true
          },
          "State": {
            "type": "string",
            "description": "Customer state (read-only)",
            "readOnly": true
          },
          "Country": {
            "type": "string",
            "description": "Customer country (read-only)",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "OrderV2": {
        "type": "object",
        "description": "Order (v2): customer as a nested object, no WarehouseNum.",
        "properties": {
          "Ordernum": {
            "type": "integer",
            "description": "Order number (read-only, assigned by the server)",
            "readOnly": true
          },
          "Customer": {
            "$ref": "#/components/schemas/CustomerV2"
          },
          "OrderDate": {
            "type": "string",
            "description": "Order date",
            "format": "date",
            "nullable": true
          },
          "ShipDate": {
            "type": "string",
            "description": "Ship date",
            "format": "date",
            "nullable": true
          },
          "PromiseDate": {
            "type": "string",
            "description": "Promise date",
            "format": "date",
            "nullable": true
          },
          "Carrier": {
            "type": "string",
            "description": "Carrier",
            "maxLength": 25,
            "nullable": true
          },
          "Instructions": {
            "type": "string",
            "description": "Shipping instructions",
            "maxLength": 50,
            "nullable": true
          },
          "PO": {
            "type": "string",
            "description": "Purchase order number",
            "maxLength": 20,
            "nullable": true
          },
          "Terms": {
            "type": "string",
            "description": "Payment terms",
            "maxLength": 20,
            "nullable": true
          },
          "SalesRep": {
            "type": "string",
            "description": "Sales rep",
            "maxLength": 4,
            "nullable": true
          },
          "BillToID": {
            "type": "integer",
            "description": "Bill-to address id",
            "nullable": true
          },
          "ShipToID": {
            "type": "integer",
            "description": "Ship-to address id",
            "nullable": true
          },
          "OrderStatus": {
            "type": "string",
            "description": "Order status",
            "maxLength": 20,
            "nullable": true
          },
          "Creditcard": {
            "type": "string",
            "description": "Credit card",
            "maxLength": 20,
            "nullable": true
          }
        },
        "additionalProperties": false,
        "example": {
          "Ordernum": 1001,
          "Customer": {
            "CustNum": 3001,
            "Name": "Golden Gate Bikes",
            "Address": "1 Test Street",
            "Address2": "",
            "PostalCode": "94016",
            "City": "San Francisco",
            "State": "CA",
            "Country": "USA"
          },
          "OrderDate": "2026-07-01",
          "ShipDate": null,
          "PromiseDate": "2026-07-15",
          "Carrier": "UPS",
          "Instructions": "Leave at the door",
          "PO": "PO-4711",
          "Terms": "Net30",
          "SalesRep": "BBB",
          "BillToID": 1,
          "ShipToID": 2,
          "OrderStatus": "Ordered",
          "Creditcard": "Visa"
        }
      },
      "OrderV2Post": {
        "type": "object",
        "description": "POST body (v2): Customer.CustNum is required. WarehouseNum (like any unknown field) is rejected with 400",
        "required": [
          "Customer"
        ],
        "properties": {
          "Ordernum": {
            "type": "integer",
            "description": "Order number (read-only, assigned by the server)",
            "readOnly": true
          },
          "Customer": {
            "$ref": "#/components/schemas/CustomerV2"
          },
          "OrderDate": {
            "type": "string",
            "description": "Order date",
            "format": "date",

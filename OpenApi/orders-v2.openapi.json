      "OrderV2Page": {
        "type": "object",
        "properties": {
          "Orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderV2"
            }
          },
          "Skip": {
            "type": "integer"
          },
          "Top": {
            "type": "integer"
          },
          "Next": {
            "type": "string",
            "description": "URI of the next page (only when the page is full)"
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem details",
        "properties": {
          "type": {
            "type": "string",
            "example": "about:blank"
          },
          "title": {
            "type": "string",
            "example": "Unknown field"
          },
          "status": {
            "type": "integer",
            "example": 400
          },
          "detail": {
            "type": "string",
            "example": "The field WarehouseNum is not part of this version of the API."
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                },
                "field": {
                  "type": "string",

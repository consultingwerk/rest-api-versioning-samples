          },
          "PO": {
            "type": "string",
            "description": "Purchase order number",
            "maxLength": 20,
            "nullable": true
          },
          "Terms": {
            "type": "string",
            "description": "Payment terms",
            "maxLength": 20,
            "nullable": true
          },
          "SalesRep": {
            "type": "string",
            "description": "Sales rep",
            "maxLength": 4,
            "nullable": true
          },
          "BillToID": {
            "type": "integer",
            "description": "Bill-to address id",
            "nullable": true
          },
          "ShipToID": {
            "type": "integer",
            "description": "Ship-to address id",
            "nullable": true
          },
          "OrderStatus": {
            "type": "string",
            "description": "Order status",
            "maxLength": 20,
            "nullable": true
          },
          "Creditcard": {
            "type": "string",
            "description": "Credit card",
            "maxLength": 20,
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderV2Put": {
        "type": "object",
        "description": "PUT body (v2): the complete writable representation",
        "required": [
